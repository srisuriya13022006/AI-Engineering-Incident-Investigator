# FalkorDB Connection Settings
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=mai_agent_memory
FALKORDB_PASSWORD=

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# LLM Provider Settings (Optional: for Mode B conversation extraction)
# Supported providers: gemini (default), openai, groq, ollama, or none
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Legacy / Alternative LLM providers
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SEC=15.0
